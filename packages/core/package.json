{
  "name": "@woo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "zod": "4.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp-http": {
      "types": "./dist/mcp-http.d.ts",
      "default": "./dist/mcp-http.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    }
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
